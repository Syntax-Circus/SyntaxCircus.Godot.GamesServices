<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- The game initializes the SDK only after its own consent gate. -->
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            tools:node="remove" />
        <meta-data
            android:name="com.google.android.gms.games.SUPPRESS_GAME_PROFILE_CREATION"
            android:value="true" />
        <meta-data
            android:name="org.godotengine.plugin.v2.SyntaxCircusGames"
            android:value="com.syntaxcircus.godot.gamesservices.GamesServicesPlugin" />
    </application>
</manifest>
